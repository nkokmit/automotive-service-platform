# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Origin của API Gateway. Để trống khi frontend và API cùng origin (hoặc khi
# chạy qua reverse proxy / dev proxy của Vite — mặc định /api được proxy sang
# http://localhost:8000).
#
# Chỉ cần khai báo khi deploy frontend và API ở hai domain khác nhau, ví dụ:
# VITE_API_BASE_URL=https://api.automotive-service.vn
VITE_API_BASE_URL=

# Đích proxy cho dev (mặc định trong vite.config.ts)
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_AGENT_PROXY_TARGET=http://localhost:8002
VITE_DAMAGE_PROXY_TARGET=http://localhost:8001
