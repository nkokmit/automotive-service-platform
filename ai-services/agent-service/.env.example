# LLM (Google Gemini default)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3-flash-preview

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_NEWS_COLLECTION=car_news
AUTO_SEED_ON_STARTUP=true

# MySQL Database (Synchronized with Docker MySQL 9.7)
MYSQL_DSN=mysql+aiomysql://app:apppassword123@localhost:3306/customer_vehicle_service?charset=utf8mb4

# Services
GARAGE_SERVICE_URL=http://localhost:8080
DAMAGE_SERVICE_URL=http://localhost:8001

# Server
HOST=0.0.0.0
PORT=8002
DEBUG=false
