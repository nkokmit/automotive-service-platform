# =============================================================
# Automotive Service Platform – Environment Variables
# Copy to .env and fill in real values
# =============================================================

# ── LLM (OpenAI) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Qdrant ────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_NEWS_COLLECTION=car_news
QDRANT_DENSE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@postgres:5432/automotive
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=automotive

# ── Garage Service ────────────────────────────────────────────
GARAGE_SERVICE_URL=http://garage-service:8000

# ── Damage Detection ──────────────────────────────────────────
DAMAGE_SERVICE_URL=http://damage-detection-service:8001
ONNX_MODEL_PATH=/models/yolov8s-seg.onnx
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
MAX_DETECTIONS=100
INPUT_SIZE=640

# ── General ───────────────────────────────────────────────────
DEBUG=false
TZ=Asia/Ho_Chi_Minh

