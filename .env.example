# Copy to .env, fill ALL three secrets below, then run docker compose up.
# .env is git-ignored. Do not put real secrets in this template.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=user_service
MYSQL_USER=app
MYSQL_PASSWORD=

# Database riêng cho customer-vehicle-service; entrypoint MySQL tạo ở
# backend/infra/mysql/init khi volume còn trống.
CUSTOMER_VEHICLE_MYSQL_DATABASE=customer_vehicle_service

# Valid Base64 decoding to at least 32 bytes; shared by gateway, user-service
# and customer-vehicle-service.
# Linux/macOS: openssl rand -base64 48
# PowerShell (5.1+):
# $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
# $bytes = New-Object byte[] 48
# $rng.GetBytes($bytes); $rng.Dispose()
# [Convert]::ToBase64String($bytes)
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Container DNS, NOT localhost. For IDE runs override with localhost (see README).
EUREKA_SERVER_URL=http://discovery-server:8761/eureka/
EUREKA_REGISTRY_FETCH_INTERVAL=10
JPA_SHOW_SQL=false

# Browser-facing Swagger URL; update if API_GATEWAY_PORT changes.
API_GATEWAY_URL=http://localhost:8000

# Host ports; container ports remain fixed.
API_GATEWAY_PORT=8000
DISCOVERY_SERVER_PORT=8761
USER_SERVICE_PORT=8081
CUSTOMER_VEHICLE_SERVICE_PORT=8082
MYSQL_PORT=3306

# V4 seeds admin / Admin@123 for LOCAL DEV ONLY.
# Its password is a fixed BCrypt hash, not controlled by an environment variable.

