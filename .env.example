# ==============================================================================
# Automotive Service Platform – Environment Variables Template
# Copy to .env and fill in real values before starting docker compose.
# ==============================================================================

# ── Backend: MySQL Database ───────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=user_service
MYSQL_USER=app
MYSQL_PASSWORD=
CUSTOMER_VEHICLE_MYSQL_DATABASE=customer_vehicle_service
MYSQL_PORT=3306

# ── Backend: Security & JWT ───────────────────────────────────────────────────
# Valid Base64 string decoding to at least 32 bytes (shared by gateway & services)
# Linux/macOS: openssl rand -base64 48
# PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# ── Backend: Eureka Discovery & Gateway ───────────────────────────────────────
EUREKA_SERVER_URL=http://discovery-server:8761/eureka/
EUREKA_REGISTRY_FETCH_INTERVAL=10
JPA_SHOW_SQL=false
API_GATEWAY_URL=http://localhost:8000
API_GATEWAY_PORT=8000
DISCOVERY_SERVER_PORT=8761
USER_SERVICE_PORT=8081
CUSTOMER_VEHICLE_SERVICE_PORT=8082

# ── Backend: Kafka (KRaft single-node) ─────────────────────────────────────────
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLUSTER_ID=REd9mkeFMGNXMYId4xJDNA

# ── AI Layer: LLM (OpenAI) ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── AI Layer: Qdrant Vector DB ────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_NEWS_COLLECTION=car_news
QDRANT_DENSE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── AI Layer: Damage Detection & Ports ────────────────────────────────────────
DAMAGE_SERVICE_PORT=8001
AGENT_SERVICE_PORT=8002
ONNX_MODEL_PATH=/models/yolov8s-seg.onnx
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
MAX_DETECTIONS=100
INPUT_SIZE=640

# ── General ───────────────────────────────────────────────────────────────────
DEBUG=false
TZ=Asia/Ho_Chi_Minh
