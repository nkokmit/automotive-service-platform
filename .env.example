# Copy to .env, fill ALL three secrets below, then run docker compose up.
# .env is git-ignored. Do not put real secrets in this template.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=user_service
MYSQL_USER=app
MYSQL_PASSWORD=

# Database riêng cho các service ngoài user-service; entrypoint MySQL tạo ở
# backend/infra/mysql/init khi volume còn trống.
CUSTOMER_VEHICLE_MYSQL_DATABASE=customer_vehicle_service
STAFF_MYSQL_DATABASE=staff_service

# Valid Base64 decoding to at least 32 bytes; shared by gateway and services.
# Linux/macOS: openssl rand -base64 48
# PowerShell (5.1+):
# $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
# $bytes = New-Object byte[] 48
# $rng.GetBytes($bytes); $rng.Dispose()
# [Convert]::ToBase64String($bytes)
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Container DNS, NOT localhost. For IDE runs override with localhost (see README).
EUREKA_SERVER_URL=http://discovery-server:8761/eureka/
EUREKA_REGISTRY_FETCH_INTERVAL=10
JPA_SHOW_SQL=false

# Browser-facing Swagger URL; update if API_GATEWAY_PORT changes.
API_GATEWAY_URL=http://localhost:8000

# Host ports; container ports remain fixed.
API_GATEWAY_PORT=8000
DISCOVERY_SERVER_PORT=8761
USER_SERVICE_PORT=8081
CUSTOMER_VEHICLE_SERVICE_PORT=8082
STAFF_SERVICE_PORT=8083
MYSQL_PORT=3306
KAFKA_PORT=9092

# Kafka (KRaft single-node, không cần ZooKeeper).
# KAFKA_BOOTSTRAP_SERVERS dùng khi chạy service bằng IDE (kết nối từ host).
# Trong docker compose, service dùng listener nội bộ qua biến
# KAFKA_BOOTSTRAP_SERVERS_CONTAINER (mặc định kafka:19092) nên không cần
# khai báo ở đây.
KAFKA_BOOTSTRAP_SERVERS=http://localhost:9092
# Cluster ID của broker. KHÔNG đổi sau khi đã `docker compose up` vì volume
# `kafka-data` đã lưu log theo cluster ID này; đổi sẽ khiến broker không
# khởi động lại được. Base64 URL-safe 16 byte.
KAFKA_CLUSTER_ID=REd9mkeFMGNXMYId4xJDNA

# V4 seeds admin / Admin@123 for LOCAL DEV ONLY.
# Its password is a fixed BCrypt hash, not controlled by an environment variable.
